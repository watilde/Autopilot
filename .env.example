# ---------------------------------------------------------------------------
# Autopilot configuration
# Copy to .env and fill in. Every value below has a safe default except the
# ones marked REQUIRED, so `DEVIN_MODE=mock` runs with no credentials at all.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# --- Target repository (the Superset fork we remediate) -------------------
GITHUB_OWNER=watilde
GITHUB_REPO=superset

# REQUIRED for live mode. Needs `repo` scope so Autopilot can read issues and
# post status comments. Devin uses its own GitHub integration to push branches.
GITHUB_TOKEN=

# Shared secret configured on the GitHub webhook. REQUIRED in live mode:
# the server refuses unsigned payloads unless ALLOW_UNSIGNED_WEBHOOKS=true.
GITHUB_WEBHOOK_SECRET=

# Escape hatch for local demos only. Never enable in a deployed environment.
ALLOW_UNSIGNED_WEBHOOKS=false

# --- Devin ----------------------------------------------------------------
# live = call the real Devin API. mock = deterministic in-process simulator
# that exercises every code path without spending ACUs.
DEVIN_MODE=mock

# REQUIRED when DEVIN_MODE=live. Personal (apk_user_*) or service (apk_*) key.
DEVIN_API_KEY=
DEVIN_API_BASE_URL=https://api.devin.ai/v1

# Ceiling on compute per session. Autopilot will not create a session without
# one, so a runaway task cannot silently burn budget.
DEVIN_MAX_ACU=10

# --- Orchestration policy -------------------------------------------------
# Only issues carrying this label are dispatched to Devin.
AUTOPILOT_LABEL=autopilot

# Max Devin sessions in flight at once. Backpressure, not a queue depth limit.
MAX_CONCURRENT_SESSIONS=3

# How often the reconciler polls in-flight sessions, in milliseconds.
RECONCILE_INTERVAL_MS=15000

# A session that has not reached a terminal state after this long is failed
# and surfaced on the dashboard rather than leaking as "running" forever.
SESSION_TIMEOUT_MS=3600000

# Post a status comment back on the GitHub issue at each state transition.
POST_ISSUE_COMMENTS=true

# --- Storage --------------------------------------------------------------
DATABASE_PATH=./data/autopilot.db
