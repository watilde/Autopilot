{
  "name": "autopilot",
  "version": "1.0.0",
  "private": true,
  "description": "Event-driven remediation autopilot: GitHub issues in, Devin sessions out, pull requests and metrics observable end to end.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx --env-file-if-exists=.env scripts/seed-issues.ts",
    "devin:setup": "tsx --env-file-if-exists=.env scripts/devin-setup.ts",
    "simulate": "tsx --env-file-if-exists=.env scripts/simulate.ts",
    "report": "tsx --env-file-if-exists=.env scripts/report.ts",
    "labels:sync": "tsx --env-file-if-exists=.env scripts/sync-labels.ts",
    "scenario": "tsx --env-file-if-exists=.env scripts/scenario.ts"
  },
  "dependencies": {
    "@octokit/rest": "^21.1.1",
    "fastify": "^5.2.1",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
